    {
      "id": "slam-final-comebacks",
      "question": "Who came back from two sets down to win a Grand Slam final?",
      "sql": "WITH sets AS (\n  SELECT *, string_split(regexp_replace(score, '\\(\\d+\\)', '', 'g'), ' ') AS s\n  FROM matches_main\n  WHERE level = 'G' AND round = 'F' AND NOT is_walkover\n)\nSELECT date, tournament, winner_name, loser_name, score\nFROM sets\nWHERE len(s) = 5\n  AND TRY_CAST(split_part(s[1], '-', 1) AS INT) < TRY_CAST(split_part(s[1], '-', 2) AS INT)\n  AND TRY_CAST(split_part(s[2], '-', 1) AS INT) < TRY_CAST(split_part(s[2], '-', 2) AS INT)\nORDER BY date DESC",
      "result": {
        "columns": [
          "date",
          "tournament",
          "winner_name",
          "loser_name",
          "score"
        ],
